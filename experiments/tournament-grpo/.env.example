# Required: https://api-docs.deepseek.com/zh-cn/guides/search/
DEEPSEEK_API_KEY=

# Optional: Jina Reader also supports requests without a key.
JINA_API_KEY=
# 国内备用域名：https://r.jinaai.cn；工具协议与认证方式不变。
JINA_READER_BASE_URL=https://r.jina.ai
# Author default is 20 (keyless limit); free/paid Jina keys allow 500.
JINA_RATE_LIMIT_RPM=20

# Optional proxies. Shell HTTP(S)_PROXY is ignored, as in the author's tools.
# Jina names follow the author: JINA_READER_HTTPS_PROXY > JINA_READER_PROXY > JINA_HTTPS_PROXY.
DEEPSEEK_SEARCH_PROXY=
JINA_READER_PROXY=

# Jev judge (System One API): https://docs.typesafe.ai/api/system-one
# Check: uv run python experiments/tournament-grpo/judge.py
TOURNAMENT_JUDGE_BACKEND=jev
TOURNAMENT_JUDGE_API_URL=https://api.typesafe.ai/v1/systemone
TOURNAMENT_JUDGE_MODEL_NAME=jev-1.14.0
TOURNAMENT_JUDGE_API_KEY=
# Enable explicitly only when the default per-question context is exceeded.
TOURNAMENT_JUDGE_LONG_CONTEXT=false

# Deep Research Bench RACE: separate OpenAI-compatible scoring model.
# Official DeepSeek Responses endpoint, thinking disabled.
# Also supports full OpenAI-compatible /v1/chat/completions URLs.
RACE_JUDGE_API_URL=https://api.deepseek.com/v1/responses
RACE_JUDGE_MODEL_NAME=deepseek-flash
RACE_JUDGE_API_KEY=
