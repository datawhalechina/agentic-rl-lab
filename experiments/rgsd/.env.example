# chat 评测与 analysis.py 共用此配置；trio judge 不读取这个文件。
# 任意 OpenAI 兼容的 /chat/completions 完整 URL。
RGSD_JUDGE_API_URL=https://api.openai.com/v1/chat/completions
# 评测使用的模型名称；analysis.py 据此查找评分文件，无需额外传参。
RGSD_JUDGE_MODEL_NAME=
RGSD_JUDGE_API_KEY=
# 留空表示不传 temperature（gpt-5 系列只接受默认值）。
RGSD_JUDGE_TEMPERATURE=0
