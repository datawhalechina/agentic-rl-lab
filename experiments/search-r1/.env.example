# DeepSeek 官方 Search API：https://api-docs.deepseek.com/zh-cn/guides/search/
# 也兼容 DEEPSEEK_KEY；推荐使用下方官方变量名。
DEEPSEEK_API_KEY=your_deepseek_api_key

# 可选：Keenable Search（--search-backend keenable）。不设置时走免密钥接口，
# 每个 IP 限 10 次/秒、1000 次/小时，够评测和试跑；完整训练请设置 Key。
# 无论是否设置 Key，请求都会按 Keenable 默认策略记录日志：https://docs.keenable.ai/data-privacy
# KEENABLE_API_KEY=
